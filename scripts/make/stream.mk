# Integer STREAM workload and A53 comparison targets.

sw-stream: $(STREAM_ELF) $(STREAM_BIN) $(STREAM_DISASM)

sw-stream-suite:
	$(MAKE) sw-stream STREAM_KERNEL=copy
	$(MAKE) sw-stream STREAM_KERNEL=scale
	$(MAKE) sw-stream STREAM_KERNEL=add
	$(MAKE) sw-stream STREAM_KERNEL=triad

bench-stream: $(STREAM_ELF)
	test -n "$(STREAM_MEASURE_END)"
	$(MAKE) sim-prefetch-3p-perf \
		AXI_3P_PERF_PIPELINE_TRACE=$(PREFETCH_PIPELINE_TRACE) \
		AXI_3P_PERF_ELF=$(STREAM_ELF) \
		AXI_3P_PERF_BIN=sim/stream-$(STREAM_TAG)-bench.bin \
		AXI_3P_PERF_MEMH=sim/stream-$(STREAM_TAG)-bench.memh \
		AXI_3P_PERF_MEMH_BYTES=$(STREAM_MEMH_BYTES) \
		AXI_3P_PERF_MAX_CYCLES=$(STREAM_MAX_CYCLES) \
		AXI_3P_PERF_ARGS="+memh_words=$(STREAM_MEMH_WORDS) +done_pc=$(STREAM_MEASURE_END)" \
		AXI_3P_TRACE_CSV=sim/stream-$(STREAM_TAG)-bench-trace.csv \
		AXI_3P_TRACE_REPORT=sim/stream-$(STREAM_TAG)-bench-pipeline.txt

bench-stream-suite:
	$(MAKE) bench-stream STREAM_KERNEL=copy
	$(MAKE) bench-stream STREAM_KERNEL=scale
	$(MAKE) bench-stream STREAM_KERNEL=add
	$(MAKE) bench-stream STREAM_KERNEL=triad

sim-stream: $(STREAM_ELF)
	$(MAKE) sim-prefetch-3p-perf \
		AXI_3P_PERF_PIPELINE_TRACE=$(PREFETCH_PIPELINE_TRACE) \
		AXI_3P_PERF_ELF=$(STREAM_ELF) \
		AXI_3P_PERF_BIN=sim/stream-$(STREAM_TAG)-check.bin \
		AXI_3P_PERF_MEMH=sim/stream-$(STREAM_TAG)-check.memh \
		AXI_3P_PERF_MEMH_BYTES=$(STREAM_MEMH_BYTES) \
		AXI_3P_PERF_MAX_CYCLES=$(STREAM_MAX_CYCLES) \
		AXI_3P_PERF_ARGS="+memh_words=$(STREAM_MEMH_WORDS) +expect_a0=$(STREAM_PASS)" \
		AXI_3P_TRACE_CSV=sim/stream-$(STREAM_TAG)-check-trace.csv \
		AXI_3P_TRACE_REPORT=sim/stream-$(STREAM_TAG)-check-pipeline.txt

sim-stream-suite:
	$(MAKE) sim-stream STREAM_KERNEL=copy
	$(MAKE) sim-stream STREAM_KERNEL=scale
