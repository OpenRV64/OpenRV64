sw-stream-a53-gem5: $(A53_STREAM_ELF) $(A53_STREAM_DISASM)

sim-stream-a53-gem5: sw-stream-a53-gem5
	test -x $(GEM5_AARCH64)
	test -f $(GEM5_A53_CONFIG)
	$(GEM5_AARCH64) -d $(A53_STREAM_OUTDIR) \
		$(GEM5_A53_CONFIG) --cpu=hpi --cpu-freq=1GHz \
		--num-cores=1 --mem-type=DDR3_1600_8x8 --mem-channels=1 \
		--mem-size=128MiB \
		-P 'system.cpu_cluster.cpus[0].enableIdling=False' \
		$(abspath $(A53_STREAM_ELF))
	$(PYTHON) tools/gem5_hpi_stream_report.py $(A53_STREAM_STATS) \
		--kernel $(STREAM_KERNEL) --bytes $(STREAM_BYTES) \
		--output $(A53_STREAM_REPORT)
