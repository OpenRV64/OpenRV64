#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C
export TZ=UTC

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cfg_root=${repo_root}/run/cfg
log_root=$(realpath -m \
    "${OPENRV64_RUN_LOG_ROOT:-${repo_root}/run/log}")
# shellcheck source=lib/common.sh
source "${repo_root}/run/lib/common.sh"

usage() {
    cat <<'EOF'
Usage:
  run/run CFG [start overrides ...]
  run/run status [RUN]
  run/run list
  run/run log [RUN] [LINES]
  run/run tail [RUN] [LINES]
  run/run attach [RUN]
  run/run path [RUN]
  run/run checkpoint [RUN]
  run/run command [RUN]
  run/run wait [RUN]
  run/run stop [RUN]

CFG is a run/cfg/*.cfg path or its basename, with or without .cfg.
Every target writes its common record under:

  run/log/<config-name>-<UTC timestamp>/

Every managed target accepts `--timeout-seconds N`. The default is 259200
(72 hours); zero disables it.

The first target-neutral backend is bare-metal Make simulation. It accepts:

  --jobs N
  --rebuild
  --foreground
  --manifest-only
  NAME=value

The existing linux-smp backend also accepts:

  --max-cycles N
  --checkpoint N
  --checkpoint-exit
  --host-pc-sample-period N
  --base-inputs DIR
  --simulator FILE
  --resume CHECKPOINT_OR_RUN
  --stop-cycles N
EOF
}

resolve_config() {
    local requested=$1
    local candidate=

    if [[ -f ${requested} ]]; then
        candidate=$(realpath -m "${requested}")
    elif [[ -f ${cfg_root}/${requested} ]]; then
        candidate=$(realpath -m "${cfg_root}/${requested}")
    elif [[ -f ${cfg_root}/${requested}.cfg ]]; then
        candidate=$(realpath -m "${cfg_root}/${requested}.cfg")
    else
        openrv64_run_die "configuration not found: ${requested}"
    fi

    case "${candidate}" in
        "${cfg_root}/"*.cfg) ;;
        *) openrv64_run_die \
            "configuration must be a run/cfg/*.cfg file: ${candidate}" ;;
    esac
    printf '%s' "${candidate}"
}

launch_linux_smp() {
    local config_path=$1
    local config_name=$2
    local run_id=$3
    local tmux_session=$4
    local recorded_command=$5
    shift 5
    local backend=${repo_root}/tools/run-linux-smp.sh
    local -a backend_arguments=(start
        --name "${config_name}"
        --comment "${RUN_DESCRIPTION}"
        --harts "${RUN_HARTS}"
        --threads "${RUN_THREADS}"
        --image "${RUN_IMAGE}"
        --zicclsm "${RUN_ZICCLSM}"
        --max-cycles "${RUN_MAX_CYCLES}"
        --checkpoint "${RUN_CHECKPOINT_CYCLES}"
        --monitor-seconds "${RUN_MONITOR_SECONDS}")
    if [[ -n ${RUN_KERNEL_ELF:-} ]]; then
        backend_arguments+=(--kernel-elf "${RUN_KERNEL_ELF}")
    fi
    if ((RUN_HOST_PC_SAMPLE_PERIOD > 0)); then
        backend_arguments+=(--host-pc-sample-period \
            "${RUN_HOST_PC_SAMPLE_PERIOD}")
    fi
    [[ ${RUN_REBUILD} == 0 ]] || backend_arguments+=(--rebuild)
    local resume_requested=0
    local checkpoint_requested=0
    local argument
    for argument in "$@"; do
        case "${argument}" in
            --resume) resume_requested=1 ;;
            --checkpoint|--checkpoint-cycles) checkpoint_requested=1 ;;
        esac
    done
    if ((resume_requested == 1 && checkpoint_requested == 0)); then
        backend_arguments+=(--checkpoint 0)
    fi
    backend_arguments+=("${RUN_MAKE_ARGUMENTS[@]}" "$@")

    OPENRV64_RUN_LOG_ROOT=${log_root} \
    OPENRV64_RUN_ID=${run_id} \
    OPENRV64_RUN_TMUX_SESSION=${tmux_session} \
    OPENRV64_RUN_TASK_NAME=${config_name} \
    OPENRV64_RUN_CONFIG_PATH=${config_path} \
    OPENRV64_RUN_RECORDED_COMMAND=${recorded_command} \
    OPENRV64_RUN_TIMEOUT_SECONDS=${RUN_TIMEOUT_SECONDS} \
    OPENRV64_RUN_BUILD_LOCK_NAME=${RUN_BUILD_LOCK_NAME} \
    OPENRV64_SMP_RUN_ROOT=${log_root} \
    OPENRV64_SMP_RUN_ID=${run_id} \
    OPENRV64_SMP_TMUX_SESSION=${tmux_session} \
    OPENRV64_SMP_TASK_NAME=${config_name} \
    OPENRV64_SMP_CONFIG_PATH=${config_path} \
    OPENRV64_SMP_RECORDED_COMMAND=${recorded_command} \
        exec "${backend}" "${backend_arguments[@]}"
}

launch_config() {
    local requested=$1
    shift
    local config_path config_filename config_name timestamp run_id
    local tmux_session recorded_command
    config_path=$(resolve_config "${requested}")
    config_filename=${config_path##*/}
    config_name=${config_filename%.cfg}
    [[ ${config_name} =~ ^[A-Za-z0-9._-]+$ ]] ||
        openrv64_run_die "unsafe configuration filename: ${config_filename}"

    RUN_CONFIG_VERSION=
    RUN_TARGET=
    RUN_DESCRIPTION=
    RUN_HARTS=
    RUN_THREADS=
    RUN_IMAGE=
    RUN_KERNEL_ELF=
    RUN_ZICCLSM=
    RUN_MAX_CYCLES=
    RUN_CHECKPOINT_CYCLES=
    RUN_MONITOR_SECONDS=
    RUN_HOST_PC_SAMPLE_PERIOD=0
    RUN_TIMEOUT_SECONDS=259200
    RUN_REBUILD=0
    RUN_BUILD_LOCK_NAME=
    RUN_MAKE_ARGUMENTS=()
    # shellcheck disable=SC1090
    source "${config_path}"

    [[ ${RUN_CONFIG_VERSION} == 1 ]] ||
        openrv64_run_die "${config_filename}: RUN_CONFIG_VERSION must be 1"
    [[ -n ${RUN_DESCRIPTION} ]] ||
        openrv64_run_die "${config_filename}: RUN_DESCRIPTION is required"
    [[ ${RUN_TIMEOUT_SECONDS} =~ ^[0-9]+$ ]] ||
        openrv64_run_die \
            "${config_filename}: RUN_TIMEOUT_SECONDS must be nonnegative"
    [[ ${RUN_HOST_PC_SAMPLE_PERIOD} =~ ^[0-9]+$ ]] ||
        openrv64_run_die \
            "${config_filename}: RUN_HOST_PC_SAMPLE_PERIOD must be nonnegative"
    if [[ -z ${RUN_BUILD_LOCK_NAME} ]]; then
        case "${config_name}" in
            fpga-*) RUN_BUILD_LOCK_NAME=fpga-build.lock ;;
            *) RUN_BUILD_LOCK_NAME=verilator-build.lock ;;
        esac
    fi
    [[ ${RUN_BUILD_LOCK_NAME} =~ ^[A-Za-z0-9._-]+$ ]] ||
        openrv64_run_die \
            "${config_filename}: RUN_BUILD_LOCK_NAME contains invalid characters"

    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    run_id=${config_name}-${timestamp}
    tmux_session=openrv64-${config_name}-${timestamp}
    tmux_session=${tmux_session//./-}
    recorded_command=$(openrv64_run_shell_join run/run \
        "${config_path#${repo_root}/}" "$@")
    mkdir -p "${log_root}"

    case "${RUN_TARGET}" in
        bare-metal)
            OPENRV64_RUN_LOG_ROOT=${log_root} \
            OPENRV64_RUN_ID=${run_id} \
            OPENRV64_RUN_TMUX_SESSION=${tmux_session} \
            OPENRV64_RUN_TASK_NAME=${config_name} \
            OPENRV64_RUN_CONFIG_PATH=${config_path} \
            OPENRV64_RUN_RECORDED_COMMAND=${recorded_command} \
            OPENRV64_RUN_TIMEOUT_SECONDS=${RUN_TIMEOUT_SECONDS} \
            OPENRV64_RUN_BUILD_LOCK_NAME=${RUN_BUILD_LOCK_NAME} \
                exec "${repo_root}/run/backends/make.sh" start "$@"
            ;;
        linux-smp)
            launch_linux_smp "${config_path}" "${config_name}" \
                "${run_id}" "${tmux_session}" "${recorded_command}" "$@"
            ;;
        *) openrv64_run_die \
            "${config_filename}: unsupported RUN_TARGET=${RUN_TARGET}" ;;
    esac
}

main() {
    local command=${1:-}
    [[ -n ${command} ]] || { usage; exit 2; }
    shift || true

    case "${command}" in
        status) openrv64_run_status "${log_root}" "${1:-latest}" ;;
        list|ls) openrv64_run_list "${log_root}" ;;
        log) openrv64_run_log "${log_root}" "${1:-latest}" "${2:-80}" ;;
        tail|follow)
            openrv64_run_tail "${log_root}" "${1:-latest}" "${2:-80}" ;;
        attach) openrv64_run_attach "${log_root}" "${1:-latest}" ;;
        path) openrv64_run_path "${log_root}" "${1:-latest}" ;;
        checkpoint)
            openrv64_run_checkpoint "${log_root}" "${1:-latest}" ;;
        command) openrv64_run_command "${log_root}" "${1:-latest}" ;;
        wait) openrv64_run_wait "${log_root}" "${1:-latest}" ;;
        stop) openrv64_run_stop "${log_root}" "${1:-latest}" ;;
        -h|--help|help) usage ;;
        *) launch_config "${command}" "$@" ;;
    esac
}

main "$@"
